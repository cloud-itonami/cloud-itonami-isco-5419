;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:physics` runs it.
;;
;; README "Robotics premise": a patrol-support and incident-log robot performs
;; post-check logging, incident-report printing and physical archival for
;; protective services workers (ISCO 5419). Its physical work is driving from
;; post to post for the check log, and filing printed incident-report boxes
;; onto archive shelving. It never restrains or uses force on anyone.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isco-5419"
 :cases
 [{:id :post-check-leg
   :kind :transport
   :procedure "patrol-support robot drives from one guard post to the next to log the post check"
   :params {:mass-kg 80.0 :payload-kg 3.0 :v-max-mps 1.0 :a-max-mps2 0.4
            :brake-decel-mps2 0.8 :drive-force-n 150.0 :crr 0.025
            :cog-height-m 0.65 :support-half-length-m 0.28}
   :sweep {:param :distance-m :values [30.0 60.0 120.0 200.0 300.0]}
   :quantity :cycle-time-s
   :limit {:max 240.0 :basis "estimate: a post check is due every 4 minutes during an elevated-watch period"}
   :boundary {:lo 10.0 :hi 600.0}}
  {:id :incident-box-to-archive-shelf
   :kind :manipulator
   :procedure "arm lifts a box of printed incident reports from the robot's tray onto an archive shelf"
   :params {:l1-m 0.50 :l2-m 0.45 :m1-kg 4.5 :m2-kg 3.0
            :from [0.60 0.05] :to [0.20 0.85] :duration-s 2.5 :steps 500}
   :sweep {:param :payload-kg :values [1.0 3.0 5.0 8.0 12.0]}
   :quantity :peak-tau1-nm
   :limit {:max 80.0 :basis "estimate: continuous shoulder torque of a ~8-10 kg payload class collaborative arm"}
   :boundary {:lo 0.1 :hi 30.0}}]}
